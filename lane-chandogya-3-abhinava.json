{"h":["<div class=\"tk-inline\" data-side=\"abhinava\" data-label=\"अभिनवनारायणीया\"><span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"तन्मतिमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_0\">तन्मतिमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_1\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_2\">तच्छङ्कामित्यर्थः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_3\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_4\">हननाद्यभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_5\">आकाशवत्सूक्ष्मत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_6\">हेतुरित्याह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"यथाऽऽकाशमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_7\">यथाऽऽकाशमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_8\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_9\">सूक्ष्मतरत्वमाह</span> –</span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"अशब्दमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_10\">अशब्दमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_11\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_12\">शब्दस्पर्शादिमतः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_13\">स्थूलत्वात्ततः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_14\">शब्दमात्रवतः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_15\">सूक्ष्मत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_16\">ततोऽपि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_17\">तद्रहितस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_18\">सूक्ष्मतरत्वमित्यर्थः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_19\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_20\">अस्पर्शम्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_21\">आकाशं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_22\">सूक्ष्मम्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_23\">अशब्दं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_24\">ब्रह्म</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_25\">ततोऽपि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_26\">सूक्ष्मतरमित्यन्वयः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_27\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_28\">जरादिदेहधर्मनिषेधः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_29\">इन्द्रियादिधर्मनिषेधोपलक्षणार्थ</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_30\">इत्याह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"देहेन्द्रियादीति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_31\">देहेन्द्रियादीति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_32\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_33\">देहहन्तुरात्महन्तृत्वप्रसिद्धेः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_34\">स्वदेहहननेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_35\">आत्महननप्रायश्चित्तविधानात्</span> “<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_36\">जीर्णो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_37\">वा</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_38\">विरमेदि</span>”<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_39\">ति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_40\">जराया</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_41\">आत्मधर्मत्वोक्तेः</span>, <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_42\">जरादि</span></span></div>","<div class=\"tk-inline\" data-side=\"abhinava\" data-label=\"अभिनवनारायणीया\"><span class=\"tk-ava\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_0\">देहधर्माणामात्मधर्मत्वाभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_1\">हेतुर्वाच्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_2\">इत्याशङ्क्याह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"कथमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_3\">कथमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_4\">।</span></span> <span class=\"tk-prat\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_5\">प्रकृतव्यासङ्ग</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_6\">इति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_7\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_8\">इहैव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_9\">देहादिसर्वधर्मापोहे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_10\">कृते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_11\">प्रकृतस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_12\">सगुणोपासनस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_13\">व्यासङ्गो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_14\">विक्षेपो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_15\">विरोधो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_16\">भवेत्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_17\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_18\">ब्राह्मण्यादेः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_19\">कर्तृत्वादेश्च</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_20\">अभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_21\">अधिकारानुपपत्तेरिति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_22\">इह</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_23\">नोच्यते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_24\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_25\">इन्द्रविरोचनाख्यायिकायान्तु</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_26\">आत्मशुद्धेर्विवक्षितत्वाद्देहधर्माणां</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_27\">स्वप्ने</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_28\">अदर्शनात्स्वाप्निकानां</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_29\">च</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_30\">सुषुप्ते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_31\">अभावादव्यभिचारादसङ्गत्वाच्च</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_32\">आत्मनोऽनात्मधर्मत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_33\">तेषाम्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_34\">इत्युच्यत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_35\">इत्यर्थः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_36\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_37\">आत्महननप्रायश्चित्तादिविधानन्तु</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_38\">देहात्मनोः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_39\">मिथ्यातादात्म्याभिमानिनं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_40\">प्रति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_41\">न</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_42\">परमार्थत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_43\">इति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_44\">भावः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_45\">।</span> <span class=\"w dm-conc\" data-k=\"Chandogya:3.19.3:tabhinava_1_46\">यद्यपि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_47\">इन्द्रविरोचनाख्यायिकायां</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_48\">स्वप्नादिधर्मिणः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_49\">प्रत्यगात्मनो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_50\">निर्धर्मत्वमुच्यते</span>, <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_51\">न</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_52\">तु</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_53\">दहराकाशशब्दितस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_54\">ब्रह्मणो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_55\">देहादिधर्मासंस्पृष्टत्वं</span> <span class=\"w dm-conc\" data-k=\"Chandogya:3.19.3:tabhinava_1_56\">तथापि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_57\">ब्रह्मण</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_58\">एव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_59\">प्रत्यगात्मत्वात्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_60\">तस्मिन्नुक्तं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_61\">ब्रह्मण्येवेति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_62\">भावः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_63\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_64\">अत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_65\">एव</span> '<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_66\">य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_67\">आत्मा</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_68\">अपहतपाप्मे</span>' <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_69\">त्यादिना</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_70\">अपहतपाप्मत्वादिगुणकं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_71\">दहराकाशमनूद्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_72\">सोऽन्वेष्टव्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_73\">इति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_74\">तस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_75\">पारमार्थिकेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_76\">रूपेण</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_77\">अन्वेष्टव्यतामुपक्षिप्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_78\">तस्य</span> ‘<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_79\">य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_80\">एषोऽक्षिणि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_81\">पुरुषो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_82\">दृश्यते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_83\">एष</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_84\">आत्मे</span>' <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_85\">त्यादिना</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_86\">प्रकृतस्यात्मनो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_87\">ऽन्वेष्टव्यस्याक्षिप्रत्यगात्मत्वमुक्त्वा</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_88\">तस्यैव</span> ‘<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_89\">एतं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_90\">त्वेव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_91\">ते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_92\">भूयोऽनुव्याख्यास्यामी</span>'<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_93\">त्यादिना</span> ‘<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_94\">अशरीरं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_95\">वाव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_96\">सन्तमि</span>’<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_97\">त्यनेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_98\">सर्वधर्मास्पृष्टत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_99\">दर्शयिष्यतीति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_100\">भावः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_101\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_102\">वधाद्यभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_103\">सत्यत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_104\">कूटस्थत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_105\">हेतुं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_106\">प्रश्नपूर्वकमाह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"कुत इति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_107\">कुत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_108\">इति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_109\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_110\">यदि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_111\">समानाधिकरणसमासेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_112\">ब्रह्मैवोच्यते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_113\">ब्रह्मपुरशब्देन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_114\">कथं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_115\">तर्हि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_116\">पूर्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_117\">शरीरमुक्तम्</span> ? <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_118\">तत्राह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"शरीराख्यं त्विति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_119\">शरीराख्यं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_120\">त्विति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_121\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_122\">यदि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_123\">ब्रह्मोपलब्धि</span></span></div>","<div class=\"side-zone\" data-side=\"abhinava\"><div class=\"zlabel\">अभिनवनारायणीया</div><div class=\"tika dv\"><div class=\"tk\"><span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"तन्मतिमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_0\">तन्मतिमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_1\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_2\">तच्छङ्कामित्यर्थः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_3\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_4\">हननाद्यभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_5\">आकाशवत्सूक्ष्मत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_6\">हेतुरित्याह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"यथाऽऽकाशमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_7\">यथाऽऽकाशमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_8\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_9\">सूक्ष्मतरत्वमाह</span> –</span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"अशब्दमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_10\">अशब्दमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_11\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_12\">शब्दस्पर्शादिमतः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_13\">स्थूलत्वात्ततः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_14\">शब्दमात्रवतः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_15\">सूक्ष्मत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_16\">ततोऽपि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_17\">तद्रहितस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_18\">सूक्ष्मतरत्वमित्यर्थः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_19\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_20\">अस्पर्शम्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_21\">आकाशं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_22\">सूक्ष्मम्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_23\">अशब्दं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_24\">ब्रह्म</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_25\">ततोऽपि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_26\">सूक्ष्मतरमित्यन्वयः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_27\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_28\">जरादिदेहधर्मनिषेधः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_29\">इन्द्रियादिधर्मनिषेधोपलक्षणार्थ</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_30\">इत्याह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"देहेन्द्रियादीति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_31\">देहेन्द्रियादीति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_32\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_33\">देहहन्तुरात्महन्तृत्वप्रसिद्धेः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_34\">स्वदेहहननेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_35\">आत्महननप्रायश्चित्तविधानात्</span> “<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_36\">जीर्णो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_37\">वा</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_38\">विरमेदि</span>”<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_39\">ति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_40\">जराया</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_41\">आत्मधर्मत्वोक्तेः</span>, <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_0_42\">जरादि</span></span></div><div class=\"tk\"><span class=\"tk-ava\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_0\">देहधर्माणामात्मधर्मत्वाभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_1\">हेतुर्वाच्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_2\">इत्याशङ्क्याह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"कथमिति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_3\">कथमिति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_4\">।</span></span> <span class=\"tk-prat\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_5\">प्रकृतव्यासङ्ग</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_6\">इति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_7\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_8\">इहैव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_9\">देहादिसर्वधर्मापोहे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_10\">कृते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_11\">प्रकृतस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_12\">सगुणोपासनस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_13\">व्यासङ्गो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_14\">विक्षेपो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_15\">विरोधो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_16\">भवेत्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_17\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_18\">ब्राह्मण्यादेः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_19\">कर्तृत्वादेश्च</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_20\">अभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_21\">अधिकारानुपपत्तेरिति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_22\">इह</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_23\">नोच्यते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_24\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_25\">इन्द्रविरोचनाख्यायिकायान्तु</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_26\">आत्मशुद्धेर्विवक्षितत्वाद्देहधर्माणां</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_27\">स्वप्ने</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_28\">अदर्शनात्स्वाप्निकानां</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_29\">च</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_30\">सुषुप्ते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_31\">अभावादव्यभिचारादसङ्गत्वाच्च</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_32\">आत्मनोऽनात्मधर्मत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_33\">तेषाम्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_34\">इत्युच्यत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_35\">इत्यर्थः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_36\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_37\">आत्महननप्रायश्चित्तादिविधानन्तु</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_38\">देहात्मनोः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_39\">मिथ्यातादात्म्याभिमानिनं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_40\">प्रति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_41\">न</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_42\">परमार्थत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_43\">इति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_44\">भावः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_45\">।</span> <span class=\"w dm-conc\" data-k=\"Chandogya:3.19.3:tabhinava_1_46\">यद्यपि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_47\">इन्द्रविरोचनाख्यायिकायां</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_48\">स्वप्नादिधर्मिणः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_49\">प्रत्यगात्मनो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_50\">निर्धर्मत्वमुच्यते</span>, <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_51\">न</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_52\">तु</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_53\">दहराकाशशब्दितस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_54\">ब्रह्मणो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_55\">देहादिधर्मासंस्पृष्टत्वं</span> <span class=\"w dm-conc\" data-k=\"Chandogya:3.19.3:tabhinava_1_56\">तथापि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_57\">ब्रह्मण</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_58\">एव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_59\">प्रत्यगात्मत्वात्</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_60\">तस्मिन्नुक्तं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_61\">ब्रह्मण्येवेति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_62\">भावः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_63\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_64\">अत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_65\">एव</span> '<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_66\">य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_67\">आत्मा</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_68\">अपहतपाप्मे</span>' <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_69\">त्यादिना</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_70\">अपहतपाप्मत्वादिगुणकं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_71\">दहराकाशमनूद्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_72\">सोऽन्वेष्टव्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_73\">इति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_74\">तस्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_75\">पारमार्थिकेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_76\">रूपेण</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_77\">अन्वेष्टव्यतामुपक्षिप्य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_78\">तस्य</span> ‘<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_79\">य</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_80\">एषोऽक्षिणि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_81\">पुरुषो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_82\">दृश्यते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_83\">एष</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_84\">आत्मे</span>' <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_85\">त्यादिना</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_86\">प्रकृतस्यात्मनो</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_87\">ऽन्वेष्टव्यस्याक्षिप्रत्यगात्मत्वमुक्त्वा</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_88\">तस्यैव</span> ‘<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_89\">एतं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_90\">त्वेव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_91\">ते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_92\">भूयोऽनुव्याख्यास्यामी</span>'<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_93\">त्यादिना</span> ‘<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_94\">अशरीरं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_95\">वाव</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_96\">सन्तमि</span>’<span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_97\">त्यनेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_98\">सर्वधर्मास्पृष्टत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_99\">दर्शयिष्यतीति</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_100\">भावः</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_101\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_102\">वधाद्यभावे</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_103\">सत्यत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_104\">कूटस्थत्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_105\">हेतुं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_106\">प्रश्नपूर्वकमाह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"कुत इति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_107\">कुत</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_108\">इति</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_109\">।</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_110\">यदि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_111\">समानाधिकरणसमासेन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_112\">ब्रह्मैवोच्यते</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_113\">ब्रह्मपुरशब्देन</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_114\">कथं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_115\">तर्हि</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_116\">पूर्वं</span> <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_117\">शरीरमुक्तम्</span> ? <span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_118\">तत्राह</span></span> <span class=\"tk-prat\" data-jb=\"3.19.3\" data-lemma=\"शरीराख्यं त्विति\"><span class=\"w\" data-k=\"Chandogya:3.19.3:tabhinava_1_119\">शरीराख्यं</span> <span class=\"w\" data-k=\"Chand