{"h":["<div class=\"tk-inline\" data-side=\"anubhuti\" data-label=\"अनुभूतिप्रकाशः\"><span class=\"ap-hd\">श्लोकाः ६।५१ · मु २।१।१</span> <span class=\"ap-sl\"><span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_0\"><span class=\"bhsj\">तदेतदक्षरं</span><span class=\"bhsp\">तत् एतत् अक्षरम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_1\"><span class=\"bhsj\">सत्यं</span><span class=\"bhsp\">सत्यम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_2\"><span class=\"bhsj\">मायाशक्तिसमन्वितम्</span><span class=\"bhsp\">माया-शक्ति-समन्वितम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_3\">।</span></span> <span class=\"ap-sl\"><span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_4\"><span class=\"bhsj\">तस्मात्सर्वे</span><span class=\"bhsp\">तस्मात् सर्वे</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_5\"><span class=\"bhsj\">समुत्पन्ना</span><span class=\"bhsp\">समुत्पन्नाः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_6\"><span class=\"bhsj\">विस्फुलिङ्गा</span><span class=\"bhsp\">विस्फुलिङ्गाः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_7\"><span class=\"bhsj\">यथामितः</span><span class=\"bhsp\">यथा अमितः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_8\">॥</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_9\">५१</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_10\">॥</span></span> <details class=\"ap-tk\"><summary>मितप्रकाशविवृतिः</summary><div class=\"ap-tkb\"> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_11\"><span class=\"bhsj\">याऽक्षराधिगमिनी</span><span class=\"bhsp\">या अक्षर-अधिगमिनी</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_12\">विद्या</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_13\">शिष्याय</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_14\">गुरुणा</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_15\">वक्तव्या</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_16\"><span class=\"bhsj\">तामतः</span><span class=\"bhsp\">ताम् अतः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_17\">परेण</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_18\"><span class=\"bhsj\">मुण्डकसमाप्तिपर्यन्तेन</span><span class=\"bhsp\">मुण्डक-समाप्ति-पर्यन्तेन</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_19\">ग्रन्थेन</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_20\"><span class=\"bhsj\">गुरुराहेत्याह</span><span class=\"bhsp\">गुरुः आह इति आह</span></span> - <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_21\"><span class=\"bhsj\">तदेतदक्षरं</span><span class=\"bhsp\">तत् एतत् अक्षरम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_22\">सत्यमित्यादिना</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_23\">।</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_24\"><span class=\"bhsj\">षष्ठाध्यायसमाप्तिपर्यन्तेन</span><span class=\"bhsp\">षष्ठ-अध्याय-समाप्ति-पर्यन्तेन</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_25\">ग्रन्थेन</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_26\">।</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_27\">तत्र</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_28\" data-g=\"anubhuti\" data-flag>ताव</span></span> <span class=\"tk-prat\" data-jb=\"2.1.1\" data-lemma=\"तदेतत्सत्यं यथा सुदीप्तात्पावकाद्विस्फुलिङ्गाः सहस्रशः प्रभवन्ते सरूपाः तथाक्षराद्विविधाः सोम्य भावाः प्रजायन्ते तत्र चैवापियन्ति\" data-jmo=\"1\" data-jpin=\"Mundaka:2.1.1:0\" data-jpinw=\"तत्\" data-jmt=\"Mundaka:2.1.1:0\">\" <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_29\"><span class=\"bhsj\">तदेतत्सत्यं</span><span class=\"bhsp\">तत् एतत् सत्यम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_30\">यथा</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_31\"><span class=\"bhsj\">सुदीप्तात्पावकाद्विस्फुलिङ्गाः</span><span class=\"bhsp\">सुदीप्तात् पावकात् विस्फुलिङ्गाः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_32\">सहस्रशः</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_33\">प्रभवन्ते</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_34\">सरूपाः</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_35\">।</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_36\"><span class=\"bhsj\">तथाक्षराद्विविधाः</span><span class=\"bhsp\">तथा अक्षरात् विविधाः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_37\">सोम्य</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_38\">भावाः</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_39\">प्रजायन्ते</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_40\">तत्र</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_41\"><span class=\"bhsj\">चैवापियन्ति</span><span class=\"bhsp\">च एव अपियन्ति</span></span> \"</span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_42\">इति</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_43\"><span class=\"bhsj\">मन्त्रं</span><span class=\"bhsp\">मन्त्रम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_44\">व्याचष्टे</span> - <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_45\"><span class=\"bhsj\">तदेतदक्षरमिति</span><span class=\"bhsp\">तत् एतत् अक्षरम् इति</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_46\">॥</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_47\">५१</span> <span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_48\">॥</span></span> </div></details></div>","<div class=\"side-zone\" data-side=\"anubhuti\"><div class=\"zlabel\">अनुभूतिप्रकाशः</div><div class=\"tika dv\"><div class=\"tk\"><span class=\"ap-hd\">श्लोकाः ६।५१ · मु २।१।१</span> <span class=\"ap-sl\"><span class=\"w\" data-k=\"Mundaka:2.1.1:tanubhuti_0_0\"><span class=\"bhsj\">तदेतदक्षरं</span><span class=\"bhsp\">त