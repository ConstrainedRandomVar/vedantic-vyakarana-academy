ass=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_20\"><span class=\"bhsj\">एतद्यो</span><span class=\"bhsp\">एतत् यः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_21\">वेद</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_22\"><span class=\"bhsj\">निहितं</span><span class=\"bhsp\">निहितम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_23\"><span class=\"bhsj\">गुहायां</span><span class=\"bhsp\">गुहायाम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_24\" data-g=\"anubhuti\" data-flag>सो</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_25\">विद्याग्रन्थिं</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_26\"><span class=\"bhsj\">विकिरतीह</span><span class=\"bhsp\">विकिरति इह</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_27\">सोम्ये</span> \"</span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_28\">त्यस्य</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_29\"><span class=\"bhsj\">तात्पर्यं</span><span class=\"bhsp\">तात्पर्यम्</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_30\">विस्पष्टयति</span> - <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_31\">पुरुषइत्यादि</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_32\">त्रिकेण</span> , <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_33\"><span class=\"bhsj\">मन्त्रपूर्वार्द्धव्याख्या</span><span class=\"bhsp\">मन्त्र-पूर्व-अर्द्ध-व्याख्या</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_34\"><span class=\"bhsj\">पुरुष</span><span class=\"bhsp\">पुरुषः</span></span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_35\">इति</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_36\">॥</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_37\">५४</span> <span class=\"w\" data-k=\"Mundaka:2.1.10:tanubhuti_0_38\">॥</span></span> </div></details></div></div></div>"],"gt":{"ताव":["","","","