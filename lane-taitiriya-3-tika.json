{"h":["<div class=\"tk-inline\" data-side=\"tika\" data-label=\"आनन्दगिरि-टीका\"><span class=\"tk-ava\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_0\" data-g>वृत्तानुवादपूर्वंकमुत्तरवल्लीसम्बन्धमाह</span> –</span> <span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"सत्यं ज्ञानमनन्तं ब्रह्म\" data-jbt=\"Taitiriya:3.1.1::pre:b0\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_1\" data-g><span class=\"bhsj\">सत्यं</span><span class=\"bhsp\">सत्यम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_2\" data-g><span class=\"bhsj\">ज्ञानमित्यादिना</span><span class=\"bhsp\">ज्ञानम् इति आदिना</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_3\">।</span></span></div>","<div class=\"tk-inline\" data-side=\"tika\" data-label=\"आनन्दगिरि-टीका\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"तपो वक्तव्यम्\" data-jbt=\"Taitiriya:3.1.1::pre:b31\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_0\" data-g><span class=\"bhsj\">तप</span><span class=\"bhsp\">तपः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_1\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_2\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_3\" data-g><span class=\"bhsj\">पदार्थविवरणं</span><span class=\"bhsp\">पदार्थविवरणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_4\" data-g><span class=\"bhsj\">वाक्यार्थज्ञानसाधनमित्यर्थः</span><span class=\"bhsp\">वाक्यार्थज्ञानसाधनम् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_5\">।</span></span></div>","<div class=\"side-zone\" data-side=\"tika\"><div class=\"zlabel\">आनन्दगिरि-टीका</div><div class=\"tika dv\"><div class=\"tk\"><span class=\"tk-ava\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_0\" data-g>वृत्तानुवादपूर्वंकमुत्तरवल्लीसम्बन्धमाह</span> –</span> <span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"सत्यं ज्ञानमनन्तं ब्रह्म\" data-jbt=\"Taitiriya:3.1.1::pre:b0\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_1\" data-g><span class=\"bhsj\">सत्यं</span><span class=\"bhsp\">सत्यम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_2\" data-g><span class=\"bhsj\">ज्ञानमित्यादिना</span><span class=\"bhsp\">ज्ञानम् इति आदिना</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_0_3\">।</span></span></div><div class=\"tk\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"तपो वक्तव्यम्\" data-jbt=\"Taitiriya:3.1.1::pre:b31\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_0\" data-g><span class=\"bhsj\">तप</span><span class=\"bhsp\">तपः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_1\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_2\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_3\" data-g><span class=\"bhsj\">पदार्थविवरणं</span><span class=\"bhsp\">पदार्थविवरणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_4\" data-g><span class=\"bhsj\">वाक्यार्थज्ञानसाधनमित्यर्थः</span><span class=\"bhsp\">वाक्यार्थज्ञानसाधनम् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1::pre:ttika_1_5\">।</span></span></div></div></div>","<div class=\"tk-inline\" data-side=\"tika\" data-label=\"आनन्दगिरि-टीका\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"अधीहि अध्यापय कथय ।\" data-jbt=\"Taitiriya:3.1.1:b28\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_0\" data-g><span class=\"bhsj\">अधीहीति</span><span class=\"bhsp\">अधीहि इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_1\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_2\" data-g>अध्यापय</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_3\" data-g>स्मारय</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_4\">।</span> “<span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_5\" data-g>इक्</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_6\" data-g>स्मरणे</span>” <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_7\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_8\" data-g><span class=\"bhsj\">धातुपाठादित्यर्थः</span><span class=\"bhsp\">धातुपाठात् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_9\">।</span></span></div>","<div class=\"tk-inline\" data-side=\"tika\" data-label=\"आनन्दगिरि-टीका\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"ब्रह्मोपलब्धौ द्वाराण्युक्तवान्\" data-jbt=\"Taitiriya:3.1.1:b59\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_0\" data-g><span class=\"bhsj\">ब्रह्मोपलब्धाविति</span><span class=\"bhsp\">ब्रह्म उपलब्धौ इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_1\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_2\" data-g><span class=\"bhsj\">लक्ष्यत्वमर्थविवेकाय</span><span class=\"bhsp\">लक्ष्यत्वम् अर्थविवेकाय</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_3\" data-g>द्वाराणि</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_4\" data-g>शरीरादिचेष्टान्यथानुपपत्त्या</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_5\" data-g>हि</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_6\" data-g>साक्षिभूतश्चिद्धातुर्विविच्यत</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_7\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_8\" data-g>भावः</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_9\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_10\" data-g>न</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_11\" data-g><span class=\"bhsj\">केवलं</span><span class=\"bhsp\">केवलम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_12\" data-g><span class=\"bhsj\">त्वमर्थज्ञानं</span><span class=\"bhsp\">त्वमर्थज्ञानम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_13\" data-g><span class=\"bhsj\">वाक्यार्थज्ञानसाधनं</span><span class=\"bhsp\">वाक्यार्थज्ञानसाधनम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_14\" data-g>किन्तु</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_15\" data-g><span class=\"bhsj\">तत्पदार्थज्ञानमपीत्यभिप्रेत्य</span><span class=\"bhsp\">तत्पदार्थज्ञानम् अपि इति अभिप्रेत्य</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_16\" data-g><span class=\"bhsj\">तदर्थस्य</span><span class=\"bhsp\">तत् अर्थस्य</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_17\" data-g><span class=\"bhsj\">ब्रह्मणो</span><span class=\"bhsp\">ब्रह्मणः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_18\" data-g><span class=\"bhsj\">लक्षणमुक्तवानित्यर्थः</span><span class=\"bhsp\">लक्षणम् उक्तवान् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_19\">।</span></span></div>","<div class=\"tk-inline\" data-side=\"tika\" data-label=\"आनन्दगिरि-टीका\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"सावशेषोक्तेः\" data-jbt=\"Taitiriya:3.1.1:b139\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_0\" data-g><span class=\"bhsj\">सावशेषोक्तेरिति</span><span class=\"bhsp\">सावशेषोक्तेः इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_1\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_2\" data-g><span class=\"bhsj\">पदार्थोपलक्षणस्यैवाभिधानादखण्डवाक्यार्थस्याप्रतिपादनात्पदार्थभेदज्ञानाच्च</span><span class=\"bhsp\">पदार्थोपलक्षणस्य एव अभिधानात् अखण्डवाक्यार्थस्य अप्रतिपादनात् पदार्थभेदज्ञानात् च</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_3\" data-g><span class=\"bhsj\">पुरुषार्थासम्भवात्</span><span class=\"bhsp\">पुरुषार्थ असम्भवात्</span></span> “<span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_4\" data-g><span class=\"bhsj\">उदरमन्तरं</span><span class=\"bhsp\">उदरम् अन्तरम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_5\" data-g>कुरुत</span>”<a class=\"cite lk\" href=\"reading-taitiriya-2.html?hl=%E0%A4%89%E0%A4%A6%E0%A4%B0%E0%A4%AE%E0%A4%A8%E0%A5%8D%E0%A4%A4%E0%A4%B0%E0%A4%82%20%E0%A4%95%E0%A5%81%E0%A4%B0%E0%A5%81%E0%A4%A4&hv=1#v-2.7.1\" target=\"_blank\" rel=\"noopener\">(<span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_6\" data-g>तै</span>. <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_7\" data-g>उ</span>. <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_8\">२</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_9\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_10\">७</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_11\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_12\">१</span>)</a> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_13\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_14\" data-g><span class=\"bhsj\">निन्दितत्वादतो</span><span class=\"bhsp\">निन्दितत्वात् अतः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_15\" data-g><span class=\"bhsj\">वाक्यार्थावगतिपर्यन्तं</span><span class=\"bhsp\">वाक्यार्थावगतिपर्यन्तम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_16\" data-g>तात्पर्येण</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_17\" data-g><span class=\"bhsj\">लक्ष्यपदार्थविचारणं</span><span class=\"bhsp\">लक्ष्यपदार्थविचारणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_18\" data-g><span class=\"bhsj\">आवृत्त्याऽनुष्ठितवानित्यर्थः</span><span class=\"bhsp\">आवृत्त्या अनुष्ठितवान् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_19\">।</span></span></div>","<div class=\"side-zone\" data-side=\"tika\"><div class=\"zlabel\">आनन्दगिरि-टीका</div><div class=\"tika dv\"><div class=\"tk\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"अधीहि अध्यापय कथय ।\" data-jbt=\"Taitiriya:3.1.1:b28\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_0\" data-g><span class=\"bhsj\">अधीहीति</span><span class=\"bhsp\">अधीहि इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_1\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_2\" data-g>अध्यापय</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_3\" data-g>स्मारय</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_4\">।</span> “<span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_5\" data-g>इक्</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_6\" data-g>स्मरणे</span>” <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_7\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_8\" data-g><span class=\"bhsj\">धातुपाठादित्यर्थः</span><span class=\"bhsp\">धातुपाठात् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_0_9\">।</span></span></div><div class=\"tk\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"ब्रह्मोपलब्धौ द्वाराण्युक्तवान्\" data-jbt=\"Taitiriya:3.1.1:b59\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_0\" data-g><span class=\"bhsj\">ब्रह्मोपलब्धाविति</span><span class=\"bhsp\">ब्रह्म उपलब्धौ इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_1\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_2\" data-g><span class=\"bhsj\">लक्ष्यत्वमर्थविवेकाय</span><span class=\"bhsp\">लक्ष्यत्वम् अर्थविवेकाय</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_3\" data-g>द्वाराणि</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_4\" data-g>शरीरादिचेष्टान्यथानुपपत्त्या</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_5\" data-g>हि</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_6\" data-g>साक्षिभूतश्चिद्धातुर्विविच्यत</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_7\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_8\" data-g>भावः</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_9\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_10\" data-g>न</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_11\" data-g><span class=\"bhsj\">केवलं</span><span class=\"bhsp\">केवलम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_12\" data-g><span class=\"bhsj\">त्वमर्थज्ञानं</span><span class=\"bhsp\">त्वमर्थज्ञानम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_13\" data-g><span class=\"bhsj\">वाक्यार्थज्ञानसाधनं</span><span class=\"bhsp\">वाक्यार्थज्ञानसाधनम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_14\" data-g>किन्तु</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_15\" data-g><span class=\"bhsj\">तत्पदार्थज्ञानमपीत्यभिप्रेत्य</span><span class=\"bhsp\">तत्पदार्थज्ञानम् अपि इति अभिप्रेत्य</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_16\" data-g><span class=\"bhsj\">तदर्थस्य</span><span class=\"bhsp\">तत् अर्थस्य</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_17\" data-g><span class=\"bhsj\">ब्रह्मणो</span><span class=\"bhsp\">ब्रह्मणः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_18\" data-g><span class=\"bhsj\">लक्षणमुक्तवानित्यर्थः</span><span class=\"bhsp\">लक्षणम् उक्तवान् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_1_19\">।</span></span></div><div class=\"tk\"><span class=\"tk-prat\" data-jb=\"3.1.1\" data-lemma=\"सावशेषोक्तेः\" data-jbt=\"Taitiriya:3.1.1:b139\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_0\" data-g><span class=\"bhsj\">सावशेषोक्तेरिति</span><span class=\"bhsp\">सावशेषोक्तेः इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_1\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_2\" data-g><span class=\"bhsj\">पदार्थोपलक्षणस्यैवाभिधानादखण्डवाक्यार्थस्याप्रतिपादनात्पदार्थभेदज्ञानाच्च</span><span class=\"bhsp\">पदार्थोपलक्षणस्य एव अभिधानात् अखण्डवाक्यार्थस्य अप्रतिपादनात् पदार्थभेदज्ञानात् च</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_3\" data-g><span class=\"bhsj\">पुरुषार्थासम्भवात्</span><span class=\"bhsp\">पुरुषार्थ असम्भवात्</span></span> “<span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_4\" data-g><span class=\"bhsj\">उदरमन्तरं</span><span class=\"bhsp\">उदरम् अन्तरम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_5\" data-g>कुरुत</span>”<a class=\"cite lk\" href=\"reading-taitiriya-2.html?hl=%E0%A4%89%E0%A4%A6%E0%A4%B0%E0%A4%AE%E0%A4%A8%E0%A5%8D%E0%A4%A4%E0%A4%B0%E0%A4%82%20%E0%A4%95%E0%A5%81%E0%A4%B0%E0%A5%81%E0%A4%A4&hv=1#v-2.7.1\" target=\"_blank\" rel=\"noopener\">(<span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_6\" data-g>तै</span>. <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_7\" data-g>उ</span>. <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_8\">२</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_9\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_10\">७</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_11\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_12\">१</span>)</a> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_13\" data-g>इति</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_14\" data-g><span class=\"bhsj\">निन्दितत्वादतो</span><span class=\"bhsp\">निन्दितत्वात् अतः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_15\" data-g><span class=\"bhsj\">वाक्यार्थावगतिपर्यन्तं</span><span class=\"bhsp\">वाक्यार्थावगतिपर्यन्तम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_16\" data-g>तात्पर्येण</span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_17\" data-g><span class=\"bhsj\">लक्ष्यपदार्थविचारणं</span><span class=\"bhsp\">लक्ष्यपदार्थविचारणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_18\" data-g><span class=\"bhsj\">आवृत्त्याऽनुष्ठितवानित्यर्थः</span><span class=\"bhsp\">आवृत्त्या अनुष्ठितवान् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.1.1:ttika_2_19\">।</span></span></div></div></div>","<div class=\"tk-inline\" data-side=\"tika\" data-label=\"आनन्दगिरि-टीका\"><span class=\"tk-prat\" data-jb=\"3.2.1\" data-lemma=\"स एवं तपस्तप्त्वा\" data-jbt=\"Taitiriya:3.2.1:b19\"><span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_0\" data-g><span class=\"bhsj\">स</span><span class=\"bhsp\">सः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_1\" data-g>च</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_2\" data-g><span class=\"bhsj\">तपस्तप्त्वेति</span><span class=\"bhsp\">तपः तप्त्वा इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_3\">।</span></span> <span class=\"tk-vy\"><span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_4\" data-g><span class=\"bhsj\">कुत्रेदं</span><span class=\"bhsp\">कुत्र इदम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_5\" data-g><span class=\"bhsj\">पित्रोक्तं</span><span class=\"bhsp\">पित्रा उक्तम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_6\" data-g><span class=\"bhsj\">लक्षणं</span><span class=\"bhsp\">लक्षणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_7\" data-g><span class=\"bhsj\">क्वेदं</span><span class=\"bhsp\">क्व इदम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_8\" data-g><span class=\"bhsj\">लक्षणं</span><span class=\"bhsp\">लक्षणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_9\" data-g>वर्तते</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_10\" data-g><span class=\"bhsj\">पूरिपूर्णं</span><span class=\"bhsp\">पूरिपूर्णम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_11\" data-g><span class=\"bhsj\">भवतीत्येकाग्रेण</span><span class=\"bhsp\">भवति इति एकाग्रेण</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_12\" data-g><span class=\"bhsj\">चेतसां</span><span class=\"bhsp\">चेतसाम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_13\" data-g><span class=\"bhsj\">पर्यालोच्यान्नं</span><span class=\"bhsp\">परि आलोच्य अन्नम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_14\" data-g><span class=\"bhsj\">ब्रह्मेति</span><span class=\"bhsp\">ब्रह्म इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_15\" data-g>व्यजानात्</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_16\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_17\" data-g>अद्यते</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_18\" data-g><span class=\"bhsj\">भुज्यत</span><span class=\"bhsp\">भुज्यते</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_19\" data-g>उपलभ्यते</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_20\" data-g><span class=\"bhsj\">सर्वैरिति</span><span class=\"bhsp\">सर्वैः इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_21\" data-g><span class=\"bhsj\">सर्वप्रतिपत्तृसाधारणं</span><span class=\"bhsp\">सर्वप्रतिपत्तृसाधारणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_22\" data-g><span class=\"bhsj\">स्थूलदेहकारणं</span><span class=\"bhsp\">स्थूलदेहकारणम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_23\" data-g><span class=\"bhsj\">भूतपञ्चकं</span><span class=\"bhsp\">भूत-पञ्चकम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_24\" data-g><span class=\"bhsj\">विराट्संज्ञकमन्नशब्देनोच्यते</span><span class=\"bhsp\">विराट्संज्ञकम् अन्नशब्देन उच्यते</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_25\">।</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_26\" data-g>तस्य</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_27\" data-g>स्थूलभौतिककारणत्वात्</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_28\">।</span> “<span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_29\" data-g><span class=\"bhsj\">यतो</span><span class=\"bhsp\">यतः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_30\" data-g>वा</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_31\" data-g>इमानि</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_32\" data-g>भूतानि</span>”<a class=\"cite lk\" href=\"reading-taitiriya-3.html?hl=%E0%A4%AF%E0%A4%A4%E0%A5%8B%20%E0%A4%B5%E0%A4%BE%20%E0%A4%87%E0%A4%AE%E0%A4%BE%E0%A4%A8%E0%A4%BF%20%E0%A4%AD%E0%A5%82%E0%A4%A4%E0%A4%BE%E0%A4%A8%E0%A4%BF&hv=1#v-3.1.1\" target=\"_blank\" rel=\"noopener\">(<span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_33\" data-g>तै</span>.<span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_34\" data-g>उ</span>. <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_35\">३</span>-<span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_36\">१</span>-<span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_37\">१</span>)</a> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_38\" data-g>इतिलक्षणस्य</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_39\" data-g>यत्र</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_40\" data-g><span class=\"bhsj\">योजयितुं</span><span class=\"bhsp\">योजयितुम्</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_41\" data-g><span class=\"bhsj\">शक्यत्वात्तद्ब्रह्मेति</span><span class=\"bhsp\">शक्यत्वात् तत् ब्रह्म इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_42\" data-g><span class=\"bhsj\">प्रतिपन्नवानित्यर्थः</span><span class=\"bhsp\">प्रतिपन्नवान् इति अर्थः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_43\">।</span></span></div>","<div class=\"side-zone\" data-side=\"tika\"><div class=\"zlabel\">आनन्दगिरि-टीका</div><div class=\"tika dv\"><div class=\"tk\"><span class=\"tk-prat\" data-jb=\"3.2.1\" data-lemma=\"स एवं तपस्तप्त्वा\" data-jbt=\"Taitiriya:3.2.1:b19\"><span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_0\" data-g><span class=\"bhsj\">स</span><span class=\"bhsp\">सः</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_1\" data-g>च</span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_2\" data-g><span class=\"bhsj\">तपस्तप्त्वेति</span><span class=\"bhsp\">तपः तप्त्वा इति</span></span> <span class=\"w\" data-k=\"Taitiriya:3.2.1:ttika_0_3\">।</span